            <t t-foreach="docs" t-as="property">
                <t t-call="web.external_layout">
                    <header>
                        <h1>My Logo</h1>
                        <hr/>
                        <div>
                            <span>MyCompany Inc.</span>
                        </div>
                        <div>
                            <span>150 Biomedical Campus BSD</span>
                        </div>
                        <div>
                            <span>Tangerang Selatan, Banten</span>
