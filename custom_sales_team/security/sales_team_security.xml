<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_sale_team_leader" model="res.groups">
        <field name="name">User: Team Leader</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="sales_team.res_groups_privilege_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">the user will have access to all records of everyone in his team in the sales application</field>
    </record>

    <!-- Record Rules -->

    <record id="sale_order_leader_rule" model="ir.rule">
        <field name="name">Team Orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">['|', ('team_id', 'in', user.teams_as_leader), '&amp;', ('team_id', 'in', user.id), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_sale_team_leader'))]"/>
    </record>
</odoo>