<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_branch_list_view" model="ir.ui.view">
        <field name="name">sale.branch.list</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <list string="Branch">
                <field name="name"/>
                <field name="code"/>
                <field name="sequence_id"/>
            </list>
        </field>
    </record>

    <record id="sale_branch_form_view" model="ir.ui.view">
        <field name="name">sale.branch.form</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <form string="Branch">
                <sheet>
                    <group col="2">
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="sale_branch_action" model="ir.actions.act_window">
        <field name="name">Sale Branch</field>
        <field name="res_model">sale.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>