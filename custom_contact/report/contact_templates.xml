<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="contact_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="user">
                            <td>
                                <span t-field="user.name"/>
                            </td>
                            <td>
                                <span t-field="user.email"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
</odoo>